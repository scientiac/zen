title = Ghostty

theme = light:Nvim Light,dark:Nvim Dark

font-size = 12

mouse-hide-while-typing = true

window-padding-x = 8
window-padding-y = 4

gtk-titlebar = false
window-theme = ghostty

linux-cgroup = single-instance
gtk-single-instance = true
gtk-wide-tabs = false

quick-terminal-position = top

keybind = ctrl+shift+o=toggle_tab_overview
keybind = ctrl+s=toggle_quick_terminal
