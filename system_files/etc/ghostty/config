title = Ghostty

theme = light:Catppuccin Latte,dark:Catppuccin Mocha

font-size = 12

mouse-hide-while-typing = true

window-padding-x = 8
window-padding-y = 4

window-width = 150
window-height = 35

gtk-titlebar = false
window-theme = ghostty

linux-cgroup = single-instance
